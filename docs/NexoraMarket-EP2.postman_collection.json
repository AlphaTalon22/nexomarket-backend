    {
      "name": "3. Flujos asíncronos con RabbitMQ",
      "description": "Productores en ms-pedidos y ms-pago; consumidores en ms-pedidos y ms-notificaciones.",
      "item": [
        {
          "name": "Crear pedido → evento pedido.creado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "const p = pm.response.json(); pm.collectionVariables.set('pedidoId', p.id);",
                  "pm.test('Devuelve el pedido creado con id', () => pm.expect(p.id).to.be.a('number'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pedidos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pedidos"
              ]
            },
            "description": "Revisar en el log de ms-notificaciones: [NOTIFICACION] Recibimos tu pedido...",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": 1,\n  \"total\": 450000,\n  \"estado\": \"PENDIENTE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Pagar pedido → pago.aprobado + boleta.generar",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "pm.test('Pago aprobado', () => pm.expect(pm.response.json().estado).to.eql('APROBADO'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pagos/procesar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pagos",
                "procesar"
              ]
            },
            "description": "ms-pedidos cambia el pedido a PAGADO; ms-notificaciones notifica y genera la boleta.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pedidoId\": {{pedidoId}},\n  \"monto\": 450000,\n  \"metodoPago\": \"DEBITO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Verificar pedido PAGADO",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// El pago se procesa de forma asíncrona: esperar 3 s antes de consultar el pedido",
                  "setTimeout(() => {}, 3000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('El pedido quedó PAGADO', () => pm.expect(pm.response.json().estado).to.eql('PAGADO'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pedidos/{{pedidoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pedidos",
                "{{pedidoId}}"
              ]
            },
            "description": "Esperar 1-2 segundos después del pago (es asíncrono)."
          }
        }
      ]
    },
