  "item": [
    {
      "name": "1. Seguridad JWT (API Manager / BFF)",
      "description": "Evidencia de que el API Manager y el BFF validan el JWT.",
      "item": [
        {
          "name": "Sin token → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos"
              ]
            },
            "description": "El Gateway rechaza la petición antes de enrutarla.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Token inválido → 401",
          "event": [
            {
              "listen": "test",
              "script": {
