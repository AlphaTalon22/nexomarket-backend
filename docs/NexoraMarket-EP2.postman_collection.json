              "raw": "{{baseUrl}}/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos"
              ]
            },
            "description": "Token alterado: el Gateway valida la firma y lo rechaza.",
            "auth": {
              "type": "bearer",
